# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Server ────────────────────────────────────────────────────────────────────
# HOST defaults to 0.0.0.0 (all interfaces) — correct for Docker.
# PORT defaults to 8080. Uncomment and change only if needed.
# HOST=0.0.0.0
# PORT=8080

# ── Resend ────────────────────────────────────────────────────────────────────
# Sign up at https://resend.com (free tier: 3,000 emails/month, 100/day).
# After signing up, create an API key under Settings → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "From" address shown on contact form emails.
# Must be from a domain you have verified in your Resend account.
# See: https://resend.com/docs/dashboard/domains/introduction
CONTACT_FROM=The Stewards Watch <noreply@mail.thestewardswatch.com>

# Where contact form submissions are delivered (your inbox).
CONTACT_TO=thestewardswatch@gmail.com
